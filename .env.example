# RetailerOS Production Configuration
PORT=3006
DATABASE_URL=postgresql://retaileros_prod:<password>@localhost:5432/retaileros_prod

# Security — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=

# Frontend origin (CORS) — comma-separated for multiple origins
FRONTEND_ORIGIN=https://retaileros.in,https://www.retaileros.in

# WATI WhatsApp Business API
WATI_ENDPOINT=https://live-mt-server.wati.io/XXXXXX
WATI_TOKEN=Bearer eyJ...

# OpenAI
OPENAI_API_KEY=sk-...
